<%- include('partials/header', { pageTitle: '画像PDF要約 - 診療支援AIポータル', activePage: 'ocr-pdf' }) %>

      <header class="content-header">
        <h1>画像PDFサマリー生成ツール</h1>
        <p class="subtitle">画像ファイル(PDF)をアップロードしてAI要約します</p>
      </header>

      <section class="card">
        <div class="drop-zone" id="drop-zone">
          <div class="drop-icon">📤</div>
          <p id="drop-text">ここにPDFファイルをドラッグ＆ドロップ<br>またはクリックしてファイルを選択</p>
          <input type="file" id="file-input" accept="application/pdf">
        </div>

        <div class="action-area">
          <button id="upload-btn" class="btn btn-primary" disabled>要約を実行する</button>
        </div>

        <!-- 進捗表示プログレスバーエリア -->
        <div id="progress-container" style="display: none; margin-top: 20px;">
          <div id="status-text" style="font-weight: bold; margin-bottom: 8px;">準備中...</div>
          <progress id="progress-bar" value="0" max="100" style="width: 100%; height: 20px;"></progress>
        </div>

        <div id="status" class="status-message"></div>
        <div id="result" class="result-box" style="display: none;"></div>
      </section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const dropZone = document.getElementById('drop-zone');
  const fileInput = document.getElementById('file-input');
  const uploadBtn = document.getElementById('upload-btn');
  const dropText = document.getElementById('drop-text');
  const progressContainer = document.getElementById('progress-container');
  const statusText = document.getElementById('status-text');
  const progressBar = document.getElementById('progress-bar');
  const statusDiv = document.getElementById('status');
  const resultDiv = document.getElementById('result');

  let selectedFile = null;

  // ファイル選択・ドラッグ＆ドロップイベント
  dropZone.addEventListener('click', () => fileInput.click());

  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('dragover');
  });

  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));

  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    if (e.dataTransfer.files.length > 0) {
      handleFileSelect(e.dataTransfer.files[0]);
    }
  });

  fileInput.addEventListener('change', (e) => {
    if (e.target.files.length > 0) {
      handleFileSelect(e.target.files[0]);
    }
  });

  function handleFileSelect(file) {
    if (file.type !== 'application/pdf') {
      alert('PDFファイルを選択してください。');
      return;
    }
    selectedFile = file;
    dropText.innerText = `選択されたファイル: ${file.name}`;
    uploadBtn.disabled = false;
  }

  // 要約実行ボタン押下処理 (ReadableStream 読み取り対応)
  uploadBtn.addEventListener('click', async () => {
    if (!selectedFile) return;

    // UI初期化
    uploadBtn.disabled = true;
    resultDiv.style.display = 'none';
    statusDiv.innerText = '';
    statusText.style.color = '';
    progressContainer.style.display = 'block';
    progressBar.value = 0;
    statusText.innerText = 'サーバーへ送信中...';

    const formData = new FormData();
    formData.append('pdf', selectedFile);

    try {
      const response = await fetch('/api/summarize-image-pdf', {
        method: 'POST',
        body: formData
      });

      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }

      // ReadableStream を使用してSSEイベントをリアルタイム解析
      const reader = response.body.getReader();
      const decoder = new TextDecoder('utf-8');
      let buffer = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n\n');
        buffer = lines.pop(); // 未完結の行をバッファに残す

// 修正前:
        // for (const line of lines) {
        //   if (line.startsWith('data: ')) {
        //     const data = JSON.parse(line.replace('data: ', ''));
        //     ...
        //   }
        // }

        // 修正後（安全なパース処理）:
        for (const line of lines) {
          const trimmedLine = line.trim();
          if (!trimmedLine || !trimmedLine.startsWith('data:')) continue;

          // 'data:' 以降の純粋なJSON文字列を取り出す
          const jsonString = trimmedLine.replace(/^data:\s*/, '');

          try {
            const data = JSON.parse(jsonString);

            // 進捗状況の更新
            if (data.percent >= 0) {
              progressBar.value = data.percent;
              statusText.innerText = `[${data.percent}%] ${data.message}`;
            } else {
              // サーバー側からのエラーハンドリング
              statusText.innerText = `エラー: ${data.message}`;
              statusText.style.color = 'red';
            }

            // 最終サマリー結果の受領・表示
            if (data.summary) {
              resultDiv.style.display = 'block';
              resultDiv.innerHTML = `
                <h3>要約結果 (全 ${data.totalPages} ページ)</h3>
                <div style="white-space: pre-wrap;">${data.summary}</div>
              `;
            }
          } catch (e) {
            console.warn('JSONパーススキップ（不完全なデータ）:', jsonString, e);
          }
        }
      }

    } catch (error) {
      console.error('通信エラー:', error);
      statusText.innerText = `通信エラーが発生しました: ${error.message}`;
      statusText.style.color = 'red';
    } finally {
      uploadBtn.disabled = false;
    }
  });
});
</script>

<%- include('partials/footer', { apiEndpoint: '/api/summarize-image-pdf' }) %>
